# Local PostgreSQL started by docker-compose.yml. Development credentials only.
# Use a postgresql+psycopg:// URL for this SQLAlchemy driver.
DATABASE_URL=postgresql+psycopg://stayput:stayput_dev@127.0.0.1:5432/stayput
# Temporary development wildcard; set on the FastAPI Railway service too.
# For production, replace * with comma-separated frontend origins (no URL paths).
CORS_ORIGINS=*
# During an alert, retain a GPS reading only after BOTH thresholds are met.
# The first GPS fix after an alert is retained immediately.
ALERT_GPS_INTERVAL_SECONDS=30
ALERT_GPS_DISTANCE_METERS=25
