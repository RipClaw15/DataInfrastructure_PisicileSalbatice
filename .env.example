# Optional override: start.sh/start.ps1 normally detect this automatically.
# For direct Compose phone setup, use the Docker host's Wi-Fi/LAN IPv4 address.
# Example: LAN_IP=192.168.1.42. Do not use localhost or a Docker/container IP.
LAN_IP=

# Optional published ports; defaults work on a machine without conflicting services.
APP_PORT=8000
POSTGRES_PORT=5432
METRO_PORT=8081
